# Set these in Vercel for each deployment environment. Do not commit real values.
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-production-domain.example
APP_URL=https://your-production-domain.example
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://your-production-domain.example/payment/verify
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Connect two Vercel Blob stores: public for images/videos and private for PDFs.
PUBLIC_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=
